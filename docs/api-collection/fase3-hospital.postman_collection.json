                "query": "query {\n  allAppointmentHistories {\n    id appointmentId patientId doctorId patientName doctorName dateTime status description eventType receivedAt\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{historyUrl}}/graphql",
              "host": [ "{{historyUrl}}" ],
              "path": [ "graphql" ]
            }
          }
        },
        {
          "name": "upcomingAppointments (sucesso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.test('status 200', () => pm.response.to.have.status(200));" ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query($patientId: ID!) {\n  upcomingAppointments(patientId: $patientId) {\n    id appointmentId patientId doctorId dateTime status description eventType receivedAt\n  }\n}",
                "variables": "{\n  \"patientId\": \"{{patientId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{historyUrl}}/graphql",
              "host": [ "{{historyUrl}}" ],
              "path": [ "graphql" ]
            }
          }
        },
        {
          "name": "GraphQL sem token (erro)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bloqueado (401/403)', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query { allAppointmentHistories { id } }",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{historyUrl}}/graphql",
              "host": [ "{{historyUrl}}" ],
              "path": [ "graphql" ]
            },
            "description": "Cenario de erro: GraphQL sem Authorization."
          }
        }
      ]
    }
  ]
}
